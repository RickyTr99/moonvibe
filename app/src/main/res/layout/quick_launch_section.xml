<?xml version="1.0" encoding="utf-8"?>
<!-- Quick launch row of the home screen, filled by QuickLaunchView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickLaunchSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:id="@+id/quickLaunchTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="@string/apollo_section_quick_launch"
        android:textAllCaps="true"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:id="@+id/quickLaunchScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="0dp"
        android:layout_marginStart="-8dp"
        android:layout_marginEnd="-8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/quickLaunchContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

</LinearLayout>
